<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="cach2cach_gripper" params="parent">

    <!-- Gripper mounting frame -->
    <joint name="cach2cach_gripper_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="cach2cach_gripper_base"/>
      <origin xyz="0 0 0.04" rpy="3.141592653589793 0 0"/>
    </joint>

    <!-- Main gripper housing -->
    <link name="cach2cach_gripper_base">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.0002" ixy="0" ixz="0"
                 iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.08 0.11 0.035"/>
        </geometry>
        <material name="DarkGray">
          <color rgba="0.15 0.15 0.18 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.08 0.11 0.035"/>
        </geometry>
      </collision>
    </link>

    <!-- Left finger -->
    <link name="cach2cach_left_finger">
      <inertial>
        <origin xyz="0 0 0.06"/>
        <mass value="0.025"/>
        <inertia ixx="0.00004" ixy="0" ixz="0"
                 iyy="0.00004" iyz="0" izz="0.000002"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0.06"/>
        <geometry>
          <box size="0.015 0.015 0.12"/>
        </geometry>
        <material name="Blue">
          <color rgba="0.1 0.35 0.95 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.06"/>
        <geometry>
          <box size="0.015 0.015 0.12"/>
        </geometry>
      </collision>
    </link>

    <!-- Right finger -->
    <link name="cach2cach_right_finger">
      <inertial>
        <origin xyz="0 0 0.06"/>
        <mass value="0.025"/>
        <inertia ixx="0.00004" ixy="0" ixz="0"
                 iyy="0.00004" iyz="0" izz="0.000002"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0.06"/>
        <geometry>
          <box size="0.015 0.015 0.12"/>
        </geometry>
        <material name="Blue">
          <color rgba="0.1 0.35 0.95 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.06"/>
        <geometry>
          <box size="0.015 0.015 0.12"/>
        </geometry>
      </collision>
    </link>

    <!-- Left finger slides inward -->
    <joint name="cach2cach_left_finger_joint" type="prismatic">
      <parent link="cach2cach_gripper_base"/>
      <child link="cach2cach_left_finger"/>
      <origin xyz="0 0.045 0.02" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.025"
             effort="100" velocity="0.1"/>
      <dynamics damping="1.0" friction="0.0"/>
    </joint>

    <!-- Right finger slides inward -->
    <joint name="cach2cach_right_finger_joint" type="prismatic">
      <parent link="cach2cach_gripper_base"/>
      <child link="cach2cach_right_finger"/>
      <origin xyz="0 -0.045 0.02" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.025"
             effort="100" velocity="0.1"/>
      <dynamics damping="1.0" friction="0.0"/>
    </joint>

  </xacro:macro>

</robot>
