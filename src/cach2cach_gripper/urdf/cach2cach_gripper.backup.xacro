<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="cach2cach_gripper" params="parent">

    <!-- Fixed mounting joint -->
    <joint name="cach2cach_gripper_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="cach2cach_gripper_base"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </joint>

    <!-- Gripper housing -->
    <link name="cach2cach_gripper_base">
      <visual>
        <geometry>
          <box size="0.08 0.08 0.04"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.15 0.15 0.18 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.08 0.08 0.04"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.35"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.00025" ixy="0" ixz="0"
          iyy="0.00025" iyz="0"
          izz="0.00037"/>
      </inertial>
    </link>

    <!-- Left finger -->
    <link name="cach2cach_left_finger">
      <visual>
        <origin xyz="0 0 -0.06"/>
        <geometry>
          <box size="0.015 0.015 0.12"/>
        </geometry>
        <material name="blue">
          <color rgba="0.1 0.4 0.9 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.06"/>
        <geometry>
          <box size="0.015 0.015 0.12"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 -0.06"/>
        <mass value="0.05"/>
        <inertia
          ixx="0.000060" ixy="0" ixz="0"
          iyy="0.000060" iyz="0"
          izz="0.000002"/>
      </inertial>
    </link>

    <!-- Right finger -->
    <link name="cach2cach_right_finger">
      <visual>
        <origin xyz="0 0 -0.06"/>
        <geometry>
          <box size="0.015 0.015 0.12"/>
        </geometry>
        <material name="blue">
          <color rgba="0.1 0.4 0.9 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.06"/>
        <geometry>
          <box size="0.015 0.015 0.12"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 -0.06"/>
        <mass value="0.05"/>
        <inertia
          ixx="0.000060" ixy="0" ixz="0"
          iyy="0.000060" iyz="0"
          izz="0.000002"/>
      </inertial>
    </link>

    <!-- Left finger sliding joint -->
    <joint name="cach2cach_left_finger_joint" type="prismatic">
      <parent link="cach2cach_gripper_base"/>
      <child link="cach2cach_left_finger"/>
      <origin xyz="0 0.045 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0" upper="0.025"
             effort="30" velocity="0.05"/>
      <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <!-- Right finger sliding joint -->
    <joint name="cach2cach_right_finger_joint" type="prismatic">
      <parent link="cach2cach_gripper_base"/>
      <child link="cach2cach_right_finger"/>
      <origin xyz="0 -0.045 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.025"
             effort="30" velocity="0.05"/>
      <dynamics damping="1.0" friction="0.1"/>
    </joint>

  </xacro:macro>
</robot>
