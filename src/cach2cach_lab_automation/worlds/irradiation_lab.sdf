    <model name="SAMPLE-107"><pose>-5.90 4.70 0.14 0 0 0</pose><link name="link"><inertial><mass>0.06</mass></inertial><collision name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry></collision><visual name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.20 0.70 0.38 1</diffuse></material></visual><visual name="barcode"><pose>0 0 0.062 0 0 0</pose><geometry><box><size>0.20 0.13 0.003</size></box></geometry><material><pbr><metal><albedo_map>media/barcodes/107.png</albedo_map></metal></pbr></material></visual></link></model>
    <model name="SAMPLE-108"><pose>-5.45 4.70 0.14 0 0 0</pose><link name="link"><inertial><mass>0.06</mass></inertial><collision name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry></collision><visual name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.90 0.78 0.14 1</diffuse></material></visual><visual name="barcode"><pose>0 0 0.062 0 0 0</pose><geometry><box><size>0.20 0.13 0.003</size></box></geometry><material><pbr><metal><albedo_map>media/barcodes/108.png</albedo_map></metal></pbr></material></visual></link></model>
    <model name="SAMPLE-109"><pose>-5.00 4.70 0.14 0 0 0</pose><link name="link"><inertial><mass>0.06</mass></inertial><collision name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry></collision><visual name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.88 0.20 0.48 1</diffuse></material></visual><visual name="barcode"><pose>0 0 0.062 0 0 0</pose><geometry><box><size>0.20 0.13 0.003</size></box></geometry><material><pbr><metal><albedo_map>media/barcodes/109.png</albedo_map></metal></pbr></material></visual></link></model>
  </world>
