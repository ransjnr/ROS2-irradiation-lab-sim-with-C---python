<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="irradiation_lab">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <physics name="1ms" type="gz"/><gravity>0 0 -9.81</gravity>
    <light type="directional" name="lab_lighting"><pose>0 0 8 0 0 0</pose><cast_shadows>true</cast_shadows><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.4 0.2 -1</direction></light>
    <!-- One physical floor and one texture: there are no coloured source/destination mats. -->
    <model name="numbered_irradiation_floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="link"><collision name="floor_collision"><geometry><box><size>16 12 0.10</size></box></geometry></collision><visual name="single_layout"><pose>0 0 0.056 0 0 0</pose><geometry><box><size>16 12 0.012</size></box></geometry><material><pbr><metal><albedo_map>media/floor_layout.png</albedo_map><roughness>0.8</roughness></metal></pbr></material></visual></link></model>
    <!-- The source occupies the labelled north-west corner of this same floor map. -->
    <model name="source_bin"><static>true</static><pose>-5.45 4.20 0.06 0 0 0</pose><link name="link"><collision name="base"><geometry><box><size>1.7 1.5 0.08</size></box></geometry></collision><visual name="base"><geometry><box><size>1.7 1.5 0.08</size></box></geometry><material><diffuse>0.22 0.24 0.27 1</diffuse></material></visual></link></model>
    <!-- Compact central irradiation source: position slots are printed around it. -->
    <model name="irradiation_source"><static>true</static><pose>0.80 0.00 0.21 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.32</radius><length>0.40</length></cylinder></geometry></collision><visual name="body"><geometry><cylinder><radius>0.32</radius><length>0.40</length></cylinder></geometry><material><diffuse>0.23 0.24 0.25 1</diffuse></material></visual><visual name="cap"><pose>0 0 0.21 0 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.02</length></cylinder></geometry><material><diffuse>0.90 0.62 0.08 1</diffuse></material></visual></link></model>
    <!-- Code-128 labels are pasted to the top of containers in the SOURCE corner. -->
    <model name="SAMPLE-101"><pose>-5.90 3.80 0.14 0 0 0</pose><link name="link"><inertial><mass>0.06</mass></inertial><collision name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry></collision><visual name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.75 0.45 0.12 1</diffuse></material></visual><visual name="barcode"><pose>0 0 0.062 0 0 0</pose><geometry><box><size>0.20 0.13 0.003</size></box></geometry><material><pbr><metal><albedo_map>media/barcodes/101.png</albedo_map></metal></pbr></material></visual></link></model>
    <model name="SAMPLE-102"><pose>-5.45 3.80 0.14 0 0 0</pose><link name="link"><inertial><mass>0.06</mass></inertial><collision name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry></collision><visual name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.15 0.70 0.65 1</diffuse></material></visual><visual name="barcode"><pose>0 0 0.062 0 0 0</pose><geometry><box><size>0.20 0.13 0.003</size></box></geometry><material><pbr><metal><albedo_map>media/barcodes/102.png</albedo_map></metal></pbr></material></visual></link></model>
    <model name="SAMPLE-103"><pose>-5.00 3.80 0.14 0 0 0</pose><link name="link"><inertial><mass>0.06</mass></inertial><collision name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry></collision><visual name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.72 0.18 0.32 1</diffuse></material></visual><visual name="barcode"><pose>0 0 0.062 0 0 0</pose><geometry><box><size>0.20 0.13 0.003</size></box></geometry><material><pbr><metal><albedo_map>media/barcodes/103.png</albedo_map></metal></pbr></material></visual></link></model>
    <model name="SAMPLE-104"><pose>-5.90 4.25 0.14 0 0 0</pose><link name="link"><inertial><mass>0.06</mass></inertial><collision name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry></collision><visual name="body"><geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.25 0.45 0.88 1</diffuse></material></visual><visual name="barcode"><pose>0 0 0.062 0 0 0</pose><geometry><box><size>0.20 0.13 0.003</size></box></geometry><material><pbr><metal><albedo_map>media/barcodes/104.png</albedo_map></metal></pbr></material></visual></link></model>
