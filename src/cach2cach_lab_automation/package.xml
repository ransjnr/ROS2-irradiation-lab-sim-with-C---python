<?xml version="1.0"?>
<package format="3">
  <name>cach2cach_lab_automation</name>
  <version>0.1.0</version>
  <description>Barcode-driven laboratory sample handling for the cach2cach mobile manipulator.</description>
  <maintainer email="lab@example.invalid">cach2cach maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>pick_place_orchestrator</depend>
  <depend>std_msgs</depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
